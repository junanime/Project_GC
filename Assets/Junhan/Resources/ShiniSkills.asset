  passiveName: "\uC798 \uBA39\uACA0\uC2B5\uB2C8\uB2E4!"
  activeName: "\uD6C4\uC6B0\uC6B0\u2014!"
  passiveDescription: "\uC801 \uCC98\uCE58 \uC2DC 69% \uD655\uB960\uB85C \uBD88\uC528
    1\uAC1C\uAC00 \uB5A8\uC5B4\uC9D1\uB2C8\uB2E4. \uD68D\uB4DD \uBC94\uC704 \uC548\uC5D0\uC11C
    \uC8FC\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uBCF4\uC720 \uD55C\uB3C4 24 \u2192
    30 \u2192 36\uAC1C. \uAC00\uB4DD \uCC28\uBA74 \uBC14\uB2E5\uC5D0 \uB0A8\uC2B5\uB2C8\uB2E4."
  activeDescription: "\uBD88\uC528 6\uAC1C\uB85C \uC804\uBC29\uC5D0 1.5\uCD08\uAC04
    \uBD88\uC744 \uBFDC\uC2B5\uB2C8\uB2E4. \uAFB9 \uB204\uB974\uBA74 \uC774\uD6C4
    0.25\uCD08\uB9C8\uB2E4 1\uAC1C\uB97C \uC18C\uBAA8\uD574 \uC9C0\uC18D\uD569\uB2C8\uB2E4.\n\uC7AC\uC0AC\uC6A9
    \uB300\uAE30\uC2DC\uAC04 \uC5C6\uC74C. \uD53C\uD574\uB7C9 100% \u2192 120% \u2192
    140%."
