  passiveName: "\uBD88\uB2ED\uC758 \uC2DC\uC791"
  activeName: "\uBD88\uB2ED\uC758 \uB05D"
  passiveDescription: "\uC2E4\uC81C \uB300\uC26C \uACBD\uB85C\uC5D0 \uBD88\uAF43\uAE38\uC744
    \uB0A8\uAE41\uB2C8\uB2E4. \uAC01 \uAD6C\uAC04\uC740 \uC0DD\uC131 \uD6C4 3\uCD08
