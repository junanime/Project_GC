  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Ability Text_ko
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 7293f9ffd63774eb1b5120a3e14cb7f5, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 64544616472576
    m_Localized: "\uC5C5\uADF8\uB808\uC774\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 276406169031200768
    m_Localized: "\uB3C5\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 276406260525748224
    m_Localized: "\uCE68\uC5D0 \uB3C5\uC744 \uBB3B\uD600 \uC801\uC911\uD55C \uC801\uC5D0\uAC8C
      \uC77C\uC815 \uC2DC\uAC04 \uC9C0\uC18D \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 276406403371159552
    m_Localized: "\uD3ED\uBC1C\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 276406439320539136
    m_Localized: "\uCE68\uC774 \uC801\uC5D0\uAC8C \uC801\uC911\uD558\uBA74 \uD3ED\uBC1C\uC744
      \uC77C\uC73C\uCF1C \uC8FC\uBCC0 \uC801\uC5D0\uAC8C \uCD94\uAC00 \uD53C\uD574\uB97C
      \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 276406486447738880
    m_Localized: "\uC720\uB3C4\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 276406643037884416
    m_Localized: "\uCE68\uC774 \uC8FC\uBCC0\uC758 \uC801\uC744 \uCD94\uC801\uD558\uBA70
      \uD718\uC5B4\uC838 \uB0A0\uC544\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 276406846071558144
    m_Localized: "\uAD00\uD1B5\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 276406902354923520
    m_Localized: "\uCE68\uC774 \uC801\uC744 \uAD00\uD1B5\uD558\uC5EC \uB4A4\uCABD\uC758
      \uC801\uAE4C\uC9C0 \uC5F0\uC18D\uC73C\uB85C \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 276406941647163392
    m_Localized: "\uAFC0\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 276406983216910336
    m_Localized: "\uB048\uC801\uD55C \uCE68\uC73C\uB85C \uC801\uC911\uD55C \uC801\uC758
      \uC774\uB3D9 \uC18D\uB3C4\uB97C \uC77C\uC815 \uC2DC\uAC04 \uAC10\uC18C\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 276407036195164160
    m_Localized: "\uBAA8\uAE30\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 276407085163663360
    m_Localized: "\uCE68\uC774 \uC801\uC5D0\uAC8C \uC801\uC911\uD560 \uB54C\uB9C8\uB2E4
      \uCCB4\uB825\uC744 \uD68C\uBCF5\uD569\uB2C8\uB2E4. \uBCF4\uC2A4\uC5D0\uAC8C
      \uC801\uC911\uD558\uBA74 \uB354 \uB9CE\uC774 \uD68C\uBCF5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 276407136451612672
    m_Localized: "\uCE68\uADC0\uD658"
    m_Metadata:
      m_Items: []
  - m_Id: 276407167992778752
    m_Localized: "\uCE68\uC774 \uC801\uC911\uD55C \uB4A4 \uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C
      \uB418\uB3CC\uC544\uC624\uBA70, \uADC0\uD658 \uACBD\uB85C\uC758 \uC801\uC5D0\uAC8C
      \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 276407202587398144
    m_Localized: "\uCE68\uC220\uC9C4"
    m_Metadata:
      m_Items: []
  - m_Id: 276407238444503040
    m_Localized: "\uB300\uC26C \uD69F\uC218\uAC00 1 \uC99D\uAC00\uD569\uB2C8\uB2E4.
      \uB300\uC26C\uD560 \uB54C \uC2DC\uC791 \uC704\uCE58\uC5D0 \uBD84\uC2E0\uC744
      \uB0A8\uACA8 \uC0AC\uBC29\uC73C\uB85C \uCE68\uC744 \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 276407276457480192
    m_Localized: "\uC0DD\uBA85\uC5F0\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 276408032623382528
    m_Localized: "\uCD5C\uB300 \uCCB4\uB825\uC774 1\uC774 \uB418\uACE0 \uD68C\uBCF5\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uB300\uC2E0 \uCE68\uC758 \uD53C\uD574\uB7C9,
      \uBC1C\uC0AC \uC218, \uC0AC\uAC70\uB9AC\uAC00 \uD06C\uAC8C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 276408321405407232
    m_Localized: "\uBD84\uC2E0\uBC30\uC591"
    m_Metadata:
      m_Items: []
  - m_Id: 276408385523732480
    m_Localized: "\uD50C\uB808\uC774\uC5B4\uB97C \uB530\uB77C\uB2E4\uB2C8\uB294 \uBD84\uC2E0\uC744
      \uC0DD\uC131\uD569\uB2C8\uB2E4. \uBD84\uC2E0\uC740 \uD604\uC7AC \uCE68 \uB2A5\uB825\uC744
      \uAE30\uBC18\uC73C\uB85C \uD568\uAED8 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 276408415978573824
    m_Localized: "\uACE0\uC2B4\uB3C4\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 276408451193950208
    m_Localized: "\uD50C\uB808\uC774\uC5B4 \uC8FC\uBCC0\uC744 \uD68C\uC804\uD558\uB294
      \uCE68 \uACB0\uACC4\uB97C \uC0DD\uC131\uD569\uB2C8\uB2E4. \uC801\uC774 \uACB0\uACC4\uC5D0
      \uB2FF\uC73C\uBA74 \uBC18\uACA9 \uCE68\uC744 \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 276408486942003200
    m_Localized: "\uB300\uBB3C\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 276408529585491968
    m_Localized: "\uC774\uAE30\uC5B4\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 276408564805062656
    m_Localized: "\uAE30\uBCF8 \uC790\uB3D9 \uACF5\uACA9\uC744 \uC911\uC9C0\uD558\uACE0,
      \uB9C8\uC6B0\uC2A4 \uC704\uCE58\uB97C \uB530\uB77C \uC6C0\uC9C1\uC774\uB294
      \uC870\uC885 \uCE68\uC744 \uC0DD\uC131\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 276410096367751168
    m_Localized: "\uACF5\uACA9 \uBC84\uD2BC\uC744 \uAE38\uAC8C \uB20C\uB7EC \uAC15\uB825\uD55C
      \uCC28\uC9C0 \uCE68\uC744 \uBC1C\uC0AC\uD569\uB2C8\uB2E4. \uCDA9\uC804\uD560\uC218\uB85D
      \uD53C\uD574\uB7C9, \uD06C\uAE30, \uC18D\uB3C4, \uAD00\uD1B5\uB825\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 276416827978207232
    m_Localized: "\uC77C\uBC18 \uB2A5\uB825 \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 276416830738059264
    m_Localized: "\uC870\uAC74\uBD80 \uC77C\uBC18 \uB2A5\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 287476704934678528
    m_Localized: "\uC12C\uC720\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 287476712975159296
    m_Localized: "\uCE68\uC774 \uC9C0\uB098\uAC04 \uC790\uB9AC\uC5D0 2\uCD08\uAC04
      \uC12C\uC720\uC9C8 \uC120\uC744 \uB0A8\uAE41\uB2C8\uB2E4.\n\uC120\uC744 \uBC1F\uC740
      \uC801\uC740 1\uCD08\uB9C8\uB2E4 2 \uD53C\uD574\uB97C \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 287476734143811584
    m_Localized: "\uBD80\uC2DD\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 287476766737747968
    m_Localized: "\uCE68\uC5D0 \uB9DE\uC740 \uC801\uC774 3\uCD08 \uB3D9\uC548 \uBC1B\uB294
      \uD53C\uD574\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4.\n\uC77C\uBC18 \uBAAC\uC2A4\uD130\uB294
      1\uC911\uCCA9\uB2F9 15%, \uBCF4\uC2A4\uB294 1\uC911\uCCA9\uB2F9 5% \uC99D\uAC00\uD558\uBA70
      \uCD5C\uB300 3\uC911\uCCA9\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 287476806835294208
    m_Localized: "\uC555\uB825\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 287476819426594816
    m_Localized: "\uCE68\uC774 \uB0A0\uC544\uAC04 \uAC70\uB9AC\uC5D0 \uB530\uB77C
      \uD53C\uD574\uB7C9\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4.\n\uC774\uB3D9 \uAC70\uB9AC
      1\uB9C8\uB2E4 \uD53C\uD574\uB7C9\uC774 \uC99D\uAC00\uD558\uBA70 \uCD5C\uB300
      50%\uAE4C\uC9C0 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 287476836514189312
    m_Localized: "\uD45C\uC2DD\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 287476863676502016
    m_Localized: "\uCE68\uC5D0 \uB9DE\uC740 \uC801\uC5D0\uAC8C \uD45C\uC2DD\uC744
      \uB0A8\uAE41\uB2C8\uB2E4.\n\uD45C\uC2DD\uC774 \uC788\uB294 \uC801\uC744 \uB2E4\uC2DC
      \uB9DE\uD788\uBA74 \uD45C\uC2DD\uC744 \uC18C\uBAA8\uD558\uACE0 \uCD94\uAC00
      \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 287499051590180864
    m_Localized: "\uC591\uADF9\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 287499053477617664
    m_Localized: "\uCE68\uC774 \uC804\uBC29\uACFC \uD6C4\uBC29 180\uB3C4 \uB300\uCE6D
      \uBC29\uD5A5\uC73C\uB85C \uB098\uB258\uC5B4 \uBC1C\uC0AC\uB429\uB2C8\uB2E4.\n\uD604\uC7AC
      \uBCF4\uC720\uD55C \uCE68 \uAC1C\uC218\uB97C \uC591\uBD84\uD558\uC5EC \uAC01\uAC01
      \uBC1C\uC0AC\uD558\uACE0, \uBC1C\uC0AC\uCCB4 \uAC1C\uC218\uAC00 1 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 287508462152933376
    m_Localized: "\uC2E0\uACBD\uCC28\uB2E8"
    m_Metadata:
      m_Items: []
  - m_Id: 287508470684147712
    m_Localized: "12\uCD08\uB9C8\uB2E4 \uD654\uBA74 \uC548\uC758 \uBAA8\uB4E0 \uC801\uC744
      1\uCD08 \uB3D9\uC548 \uC815\uC9C0\uC2DC\uD0B5\uB2C8\uB2E4.\n\uC815\uC9C0 \uC2DC\uAC04\uC774
      \uC720\uC9C0\uB418\uB294 \uB3D9\uC548 \uC0C8\uB85C \uC2A4\uD3F0\uB41C \uC801\uB3C4
      \uC2E0\uACBD\uCC28\uB2E8 \uC0C1\uD0DC\uC5D0 \uB4E4\uC5B4\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 287508486823829504
    m_Localized: "\uB3C5 \uC804\uC5FC"
    m_Metadata:
      m_Items: []
  - m_Id: 287508511821881344
    m_Localized: "\uB3C5\uC5D0 \uC911\uB3C5\uB41C \uC801\uC744 \uCC98\uCE58\uD558\uBA74
      \uCC98\uCE58\uB41C \uC801 \uC8FC\uBCC0\uC758 \uC801\uB4E4\uC5D0\uAC8C \uB3C5\uC744
      \uC804\uC5FC\uC2DC\uD0B5\uB2C8\uB2E4.\n\uC774 \uC804\uC124\uC99D\uAC15\uC740
      \uB3C5\uCE68\uC744 \uBCF4\uC720\uD55C \uC0C1\uD0DC\uC5D0\uC11C\uB9CC \uB4F1\uC7A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 287508641639784448
    m_Localized: "\uC7A5\uAE30\uC555\uCC29"
    m_Metadata:
      m_Items: []
  - m_Id: 287508647276929024
    m_Localized: "20\uCD08\uB9C8\uB2E4 \uC801\uC774 \uBC00\uC9D1\uB41C \uC704\uCE58\uC5D0
      \uC7A5\uAE30\uC555\uCC29\uC7A5\uC744 \uC0DD\uC131\uD569\uB2C8\uB2E4.\n\uC555\uCC29\uC7A5
      \uC548\uC758 \uC801\uC740 \uC911\uC559\uC73C\uB85C \uB04C\uB824\uAC00\uBA70
      \uC9C0\uC18D \uD53C\uD574\uB97C \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 287672100126511104
    m_Localized: "\uC18C\uD654\uC561\uB0AD\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 287672101636460544
    m_Localized: "\uCE68\uC5D0 \uB9DE\uC740 \uC801\uC774 \uC8FD\uC73C\uBA74 \uADF8
      \uC704\uCE58\uC5D0 \uC18C\uD654\uC561 \uC6C5\uB369\uC774\uB97C \uC0DD\uC131\uD569\uB2C8\uB2E4.\n\uC6C5\uB369\uC774
      \uC704\uC758 \uC801\uC740 \uC9C0\uC18D \uD53C\uD574\uB97C \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 287672103217713152
    m_Localized: "\uACF5\uBCF5\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 287672104899629056
    m_Localized: "\uCE68\uC774 \uC801\uC911\uD560 \uB54C\uB9C8\uB2E4 \uC9E7\uC740
      \uC2DC\uAC04 \uB3D9\uC548 \uACF5\uACA9\uC18D\uB3C4\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4.\n\uACF5\uBCF5
      \uC2A4\uD0DD\uC740 \uCD5C\uB300 \uC911\uCCA9 \uC218\uAE4C\uC9C0 \uC313\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 287672106464104448
    m_Localized: "\uC7A5\uB0B4\uADE0\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 287672113502146560
    m_Localized: "\uCE68\uC774 \uC801\uC911\uD55C \uC801\uC5D0\uAC8C \uC7A5\uB0B4\uADE0
      \uC2A4\uD0DD\uC744 \uC313\uC2B5\uB2C8\uB2E4.\n\uC77C\uC815 \uC2A4\uD0DD \uC774\uC0C1\uC778
      \uC801\uC774 \uC8FD\uC73C\uBA74 \uCD94\uAC00 \uACBD\uD5D8\uCE58 \uAD6C\uC2AC\uC744
      \uC0DD\uC131\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 289300808520224768
    m_Localized: "\uC704\uC0B0 \uC5F0\uB3D9\uD30C\n"
    m_Metadata:
      m_Items: []
  - m_Id: 289300810709651456
    m_Localized: "\uC77C\uC815 \uC8FC\uAE30\uB9C8\uB2E4 \uC6D0\uD615 \uC704\uC0B0
      \uD30C\uB3D9\uC744 \uBC29\uCD9C\uD574 \uC801\uC5D0\uAC8C \uD53C\uD574\uB97C
      \uC8FC\uACE0 \uBC00\uC5B4\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 289300820662734848
    m_Localized: "\uC810\uB9C9 \uC694\uC0C8\n"
    m_Metadata:
      m_Items: []
  - m_Id: 289300822550171648
    m_Localized: "\uD53C\uD574\uB97C \uBC1B\uC9C0 \uC54A\uACE0 \uBC84\uD2F0\uBA74
      \uCD5C\uB300 3\uAC1C\uC758 \uC810\uB9C9 \uC2E4\uB4DC\uB97C \uC0DD\uC131\uD569\uB2C8\uB2E4.
      \uC2E4\uB4DC\uB294 \uD53C\uACA9 1\uD68C\uB97C \uB9C9\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 290940029500706816
    m_Localized: "\uD5DD\uADF8\uB9AC\uC815\uC2E0"
    m_Metadata:
      m_Items: []
  - m_Id: 290940032717737984
    m_Localized: "\uC0F7\uAC74\uCE68"
    m_Metadata:
      m_Items: []
  - m_Id: 290940031191011328
    m_Localized: "\uACBD\uD5D8\uCE58/\uACE8\uB4DC\uB97C \uBA39\uC9C0 \uC54A\uB294
      \uB3D9\uC548 \uACF5\uACA9\uB825, \uC0AC\uAC70\uB9AC, \uACF5\uACA9\uC18D\uB3C4\uAC00
      \uC99D\uAC00\uD569\uB2C8\uB2E4.\n\uD53D\uC5C5\uC744 \uD68D\uB4DD\uD558\uBA74
      \uB204\uC801 \uD6A8\uACFC\uAC00 \uCD08\uAE30\uD654\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 290940034143801344
