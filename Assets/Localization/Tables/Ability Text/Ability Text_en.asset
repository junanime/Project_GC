  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Ability Text_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 7293f9ffd63774eb1b5120a3e14cb7f5, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 276406169031200768
    m_Localized: "Poison Needle\t"
    m_Metadata:
      m_Items: []
  - m_Id: 276406260525748224
    m_Localized: Coats needles with poison, dealing damage over time to enemies hit.
    m_Metadata:
      m_Items: []
  - m_Id: 276406403371159552
    m_Localized: Explosive Needle
    m_Metadata:
      m_Items: []
  - m_Id: 276406439320539136
    m_Localized: Needles explode on hit, dealing additional damage to nearby enemies.
    m_Metadata:
      m_Items: []
  - m_Id: 276406486447738880
    m_Localized: Homing Needle
    m_Metadata:
      m_Items: []
  - m_Id: 276406643037884416
    m_Localized: Needles curve toward nearby enemies while flying.
    m_Metadata:
      m_Items: []
  - m_Id: 276406846071558144
    m_Localized: Piercing Needle
    m_Metadata:
      m_Items: []
  - m_Id: 276406902354923520
    m_Localized: Needles pierce through enemies and continue hitting targets behind
      them.
    m_Metadata:
      m_Items: []
  - m_Id: 276406983216910336
    m_Localized: Sticky needles slow enemies for a short time on hit.
    m_Metadata:
      m_Items: []
  - m_Id: 276406941647163392
    m_Localized: Honey Needle
    m_Metadata:
      m_Items: []
  - m_Id: 276407036195164160
    m_Localized: Mosquito Needle
    m_Metadata:
      m_Items: []
  - m_Id: 276407085163663360
    m_Localized: Restores health whenever a needle hits an enemy. Hitting a boss
      restores more health.
    m_Metadata:
      m_Items: []
  - m_Id: 276407136451612672
    m_Localized: Returning Needle
    m_Metadata:
      m_Items: []
  - m_Id: 276407167992778752
    m_Localized: Needles return to the player after hitting an enemy, damaging enemies
      along the return path.
    m_Metadata:
      m_Items: []
  - m_Id: 276407202587398144
    m_Localized: Acupuncture Formation
    m_Metadata:
      m_Items: []
  - m_Id: 276407238444503040
    m_Localized: Gain 1 additional dash charge. Dashing leaves a clone at the starting
      point that fires needles in all directions.
    m_Metadata:
      m_Items: []
  - m_Id: 276407276457480192
    m_Localized: Life Burn
    m_Metadata:
      m_Items: []
  - m_Id: 276408032623382528
    m_Localized: Set maximum health to 1 and prevent healing. In exchange, greatly
      increases needle damage, projectile count, and range.
    m_Metadata:
      m_Items: []
  - m_Id: 276408321405407232
    m_Localized: Clone Culture
    m_Metadata:
      m_Items: []
  - m_Id: 276408385523732480
    m_Localized: Creates a clone that follows the player and attacks using the current
      needle ability.
    m_Metadata:
      m_Items: []
  - m_Id: 276408451193950208
    m_Localized: Creates a rotating needle barrier around the player. Enemies that
      touch it trigger counter needles.
    m_Metadata:
      m_Items: []
  - m_Id: 276408415978573824
    m_Localized: Hedgehog Needle
    m_Metadata:
      m_Items: []
  - m_Id: 276408486942003200
    m_Localized: Heavy Snipe
    m_Metadata:
      m_Items: []
  - m_Id: 276408529585491968
    m_Localized: Sword-Control Needle
    m_Metadata:
      m_Items: []
  - m_Id: 276408564805062656
    m_Localized: Stops the basic automatic attack and creates a controllable needle
      that follows the mouse position.
    m_Metadata:
      m_Items: []
  - m_Id: 276410096367751168
    m_Localized: Hold the attack button to fire a powerful charged needle. The longer
      it charges, the more damage, size, speed, and piercing power it gains.
    m_Metadata:
      m_Items: []
  - m_Id: 64544616472576
    m_Localized: Upgrade
    m_Metadata:
      m_Items: []
  - m_Id: 276416827978207232
    m_Localized: Genaral Ability
    m_Metadata:
      m_Items: []
  - m_Id: 276416830738059264
    m_Localized: Genaral reason Ability
    m_Metadata:
      m_Items: []
  - m_Id: 287476704934678528
    m_Localized: Fiber Needle
    m_Metadata:
      m_Items: []
  - m_Id: 287476712975159296
    m_Localized: 'Leaves a thin fibrous trail behind the needle for 2 seconds.

      Enemies
      that step on the trail take 2 damage per second.

'
    m_Metadata:
      m_Items: []
  - m_Id: 287476734143811584
    m_Localized: Corrosion Needle
    m_Metadata:
      m_Items: []
  - m_Id: 287476766737747968
    m_Localized: 'Enemies hit by the needle take increased damage for 3 seconds.

      Normal
      monsters take 15% increased damage per stack, while boss monsters take 5% increased
      damage per stack, up to 3 stacks.

'
    m_Metadata:
      m_Items: []
  - m_Id: 287476806835294208
    m_Localized: Pressure Needle
    m_Metadata:
      m_Items: []
  - m_Id: 287476819426594816
    m_Localized: 'The needle deals more damage based on the distance it travels.

      Damage
      increases for each unit of distance traveled, up to a maximum of 50%.

'
    m_Metadata:
      m_Items: []
  - m_Id: 287476836514189312
    m_Localized: 'Marked Needle

'
    m_Metadata:
      m_Items: []
  - m_Id: 287476863676502016
    m_Localized: 'Marks enemies hit by the needle.

      Hitting a marked enemy
      again consumes the mark and deals bonus damage.'
    m_Metadata:
      m_Items: []
  - m_Id: 287499051590180864
    m_Localized: 'Bipolar Needle

'
    m_Metadata:
      m_Items: []
  - m_Id: 287499053477617664
    m_Localized: 'Needles are split and fired in both forward and backward directions
      with 180-degree symmetry.

      Your current projectile count is divided between
      both directions, and projectile count is increased by 1.'
    m_Metadata:
      m_Items: []
  - m_Id: 287508462152933376
    m_Localized: Neural Block
    m_Metadata:
      m_Items: []
  - m_Id: 287508470684147712
    m_Localized: Enemies that spawn while Neural Block is active are also frozen
      for the remaining duration.
    m_Metadata:
      m_Items: []
  - m_Id: 287508486823829504
    m_Localized: Poison Contagion
    m_Metadata:
      m_Items: []
  - m_Id: 287508511821881344
    m_Localized: 'When a poisoned enemy is killed, poison spreads to nearby enemies
      around it.

      This legendary augment only appears after obtaining Poison
      Needle.'
    m_Metadata:
      m_Items: []
  - m_Id: 287508641639784448
    m_Localized: Organ Compression
    m_Metadata:
      m_Items: []
  - m_Id: 287508647276929024
    m_Localized: 'Every 20 seconds, creates an organ compression field at a dense
      enemy cluster.

      Enemies inside the field are pulled toward the center
      and take damage over time.'
    m_Metadata:
      m_Items: []
  - m_Id: 287672100126511104
    m_Localized: Digestive Acid Sac Needle
    m_Metadata:
      m_Items: []
  - m_Id: 287672101636460544
    m_Localized: 'Enemies hit by the needle form an acid sac.

      When they die,
      they leave an acid puddle that damages enemies standing on it.'
    m_Metadata:
      m_Items: []
  - m_Id: 287672103217713152
    m_Localized: 'Hunger Needle

'
    m_Metadata:
      m_Items: []
  - m_Id: 287672104899629056
    m_Localized: 'Each needle hit grants a temporary attack speed stack.

      Hunger
      stacks can build up to a maximum limit.'
    m_Metadata:
      m_Items: []
  - m_Id: 287672106464104448
    m_Localized: Gut Bacteria Needle
    m_Metadata:
      m_Items: []
  - m_Id: 287672113502146560
    m_Localized: 'Needle hits build gut bacteria stacks on enemies.

      Enemies
      killed with enough stacks drop extra experience gems.'
    m_Metadata:
      m_Items: []
  - m_Id: 289300808520224768
    m_Localized: 'Gastric Peristalsis Wave

'
    m_Metadata:
      m_Items: []
  - m_Id: 289300810709651456
    m_Localized: Periodically releases a circular gastric acid wave that damages
      and knocks back enemies.
    m_Metadata:
      m_Items: []
  - m_Id: 289300820662734848
    m_Localized: 'Mucosal Fortress

'
    m_Metadata:
      m_Items: []
  - m_Id: 289300822550171648
    m_Localized: Avoid taking damage to gain up to 3 mucosal shields. Each shield
      blocks 1 hit.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
